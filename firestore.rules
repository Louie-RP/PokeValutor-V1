rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User-owned data only. This covers:
    // - users/{uid}/cardWatchlist/{id}
    // - users/{uid}/sealedWatchlist/{id}
    // - legacy migration collections (cardFavorites/sealedFavorites)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
