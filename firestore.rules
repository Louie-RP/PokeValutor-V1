rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isTrackedCollection(collectionId) {
      return collectionId == 'cardWatchlist'
        || collectionId == 'sealedWatchlist'
        || collectionId == 'cardFavorites'
        || collectionId == 'sealedFavorites';
    }

    function isValidTrackedItem(itemId) {
      return request.resource.data.keys().hasAll(['id', 'updatedAt'])
        && request.resource.data.id is string
        && request.resource.data.id == itemId
        && request.resource.data.id.size() > 0
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidDexState() {
      return request.resource.data.keys().hasOnly(['collection', 'masterSets', 'updatedAt', 'updatedAtServer'])
        && request.resource.data.collection is list
        && request.resource.data.masterSets is map
        && (request.resource.data.updatedAt is int || request.resource.data.updatedAt is float)
        && request.resource.data.updatedAt > 0
        && request.resource.data.updatedAtServer is timestamp;
    }

    function isValidShareToken(token) {
      return token is string
        && token.size() >= 16
        && token.size() <= 128
        && token.matches('^[A-Za-z0-9_-]+$');
    }

    function isValidDexCollectionId(collectionId) {
      return collectionId is string
        && collectionId.size() >= 1
        && collectionId.size() <= 40
        && collectionId.matches('^[a-z0-9_-]+$');
    }

    function isValidSnapshotId(snapshotId) {
      return snapshotId is string
        && snapshotId.size() >= 12
        && snapshotId.size() <= 64
        && snapshotId.matches('^[a-z0-9_-]+_[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidSharedDexDoc(shareToken) {
      return request.resource.data.keys().hasOnly([
          'enabled',
          'ownerUid',
          'collection',
          'activeCollectionId',
          'collections',
          'updatedAt',
          'updatedAtServer',
          'disabledAtServer'
        ])
        && request.resource.data.keys().hasAll([
          'enabled',
          'ownerUid',
          'collection',
          'activeCollectionId',
          'collections',
          'updatedAt'
        ])
        && request.resource.data.enabled is bool
        && request.resource.data.ownerUid is string
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.collection is list
        && isValidDexCollectionId(request.resource.data.activeCollectionId)
        && request.resource.data.collections is list
        && (request.resource.data.updatedAt is int || request.resource.data.updatedAt is float)
        && request.resource.data.updatedAt > 0
        && isValidShareToken(shareToken);
    }

    // Optional user profile doc.
    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    // Watchlist/favorites data used by the web client.
    match /users/{userId}/{collectionId}/{itemId} {
      allow read: if isOwner(userId) && isTrackedCollection(collectionId);
      allow create, update: if isOwner(userId)
        && isTrackedCollection(collectionId)
        && isValidTrackedItem(itemId);
      allow delete: if isOwner(userId) && isTrackedCollection(collectionId);
    }

    // Dex cloud-sync state used by dex-tracker-pages.js.
    match /users/{userId}/dex/state {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidDexState();
      allow delete: if isOwner(userId);
    }

    // User-level read-only value snapshots generated by Cloud Functions.
    match /users/{userId}/dexValueSnapshots/{snapshotId} {
      allow read: if isOwner(userId) && isValidSnapshotId(snapshotId);
      allow create, update, delete: if false;
    }

    // Global read-only cache for market prices consumed by trusted server code.
    match /cardPriceCache/{priceKey} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    // Public, token-based snapshot for shared read-only collection views.
    match /dexShared/{shareToken} {
      allow read: if resource.data.enabled == true && isValidShareToken(shareToken);
      allow create: if isSignedIn() && isValidSharedDexDoc(shareToken);
      allow update: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && isValidSharedDexDoc(shareToken);
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Trusted card catalog is readable by clients but writable only via Admin SDK.
    match /cardCatalog/{cardId} {
      allow read: if true;
      allow write: if false;
    }

    // Scanner name index is server-only. Client access stays blocked.
    match /scannerNameIndex/{nameId} {
      allow read, write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
